<section class="escena" id="inicio" aria-label="Inicio">
  <div class="escenario">
    <canvas id="gl" aria-hidden="true"></canvas>

    <div class="capa inicio" id="capaInicio"><div><div class="contenido">
      <p class="ceja">Software · Automatización · Mendoza</p>
      <h1>
        <span class="sube" style="animation-delay:.05s">Innovación</span>
        <span class="sube acento" style="animation-delay:.15s">concreta</span>
        <span class="sube" style="animation-delay:.25s">para empresas</span>
        <span class="sube" style="animation-delay:.35s">de Mendoza</span>
      </h1>
      <p class="bajada sube" style="animation-delay:.5s">Ordenamos tus procesos y los convertimos en software que trabaja por vos. Presupuestado con datos, entregado en semanas.</p>
      <div class="acciones sube" style="animation-delay:.65s">
        <a class="btn btn-1" href="#contacto">Pedí tu presupuesto
          <svg class="flecha" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        <a class="btn btn-2" href="#nosotros">Quiénes somos</a>
      </div>
    </div></div></div>

    <div class="capa final" id="capaFinal" style="opacity:0;visibility:hidden"><div><div class="contenido">
      <p class="ceja">Cada proyecto, una grilla ordenada</p>
      <div class="grande wm"><b>vinea</b><s></s><em>data</em></div>
      <p class="bajada">Software a medida, presupuestado con datos.</p>
      <div class="acciones">
        <a class="btn btn-1" href="#servicios">Ver qué hacemos
          <svg class="flecha" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6"/></svg></a>
      </div>
    </div></div></div>

    <div class="pista" id="pista" aria-hidden="true">Bajá y mirá cómo se ordena
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
    </div>
  </div>
</section>

<style>
  .escena{position:relative;height:300vh}
  .escenario{position:sticky;top:env(safe-area-inset-top,0px);height:100svh;overflow:hidden;background:var(--tinta)}
  #gl{position:absolute;inset:0;width:100%;height:100%;display:block}
  .escenario::after{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(90deg, var(--tinta) 0%, rgba(27,22,34,.85) 30%, rgba(27,22,34,0) 58%)}
  @media (max-width:760px){ .escenario::after{background:linear-gradient(0deg, var(--tinta) 0%, rgba(27,22,34,.9) 40%, rgba(27,22,34,0) 70%)} }
  .capa{position:absolute;z-index:3;left:0;right:0;padding-left:var(--gutter-l);padding-right:var(--gutter-r);pointer-events:none}
  .capa > div{max-width:1120px;margin:0 auto}
  .contenido{max-width:540px;pointer-events:auto}
  .inicio,.final{top:50%;transform:translateY(-50%)}
  .bajada{margin:22px 0 32px;font-size:clamp(17px,1.5vw,20px);line-height:1.55;color:var(--texto-2);max-width:480px}
  .grande{font-size:clamp(56px,8vw,112px);letter-spacing:-.04em;line-height:1}
  .pista{position:absolute;z-index:3;left:50%;transform:translateX(-50%);bottom:calc(28px + env(safe-area-inset-bottom,0px));display:flex;flex-direction:column;align-items:center;gap:10px;font:500 12px var(--mono);letter-spacing:1.4px;color:var(--texto-2);text-transform:uppercase}
  .pista svg{width:18px;height:18px;animation:baja 1.8s ease-in-out infinite}
  @keyframes baja{0%,100%{transform:translateY(0)}50%{transform:translateY(5px)}}
  .sube{display:inline-block;animation:sube .9s cubic-bezier(.2,.7,.2,1) both}
  @keyframes sube{from{transform:translateY(.35em);opacity:.25}to{transform:none;opacity:1}}
  @media (max-width:760px){
    .inicio{top:auto;transform:none;bottom:calc(88px + env(safe-area-inset-bottom,0px))}
    .final{top:auto;transform:none;bottom:calc(40px + env(safe-area-inset-bottom,0px))}
    .contenido{max-width:none}
  }
</style>

<script>
  // Escena 3D: viñedo de esferas que se ordena en el logo al scrollear.
  // Three.js se carga aparte para no frenar la primera pintura.
  const canvas = document.getElementById('gl') as HTMLCanvasElement;
  const escena = document.getElementById('inicio')!;
  const capaInicio = document.getElementById('capaInicio')!;
  const capaFinal = document.getElementById('capaFinal')!;
  const pista = document.getElementById('pista')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  const progreso = () => {
    const rect = escena.getBoundingClientRect();
    const total = escena.offsetHeight - innerHeight;
    return total > 0 ? clamp(-rect.top / total, 0, 1) : 0;
  };

  // Las capas de texto funcionan aunque WebGL no cargue.
  const capas = () => {
    const pr = progreso();
    capaInicio.style.opacity = String(clamp(1 - pr * 2.6, 0, 1));
    capaInicio.style.visibility = pr > 0.4 ? 'hidden' : 'visible';
    const fin = clamp((pr - 0.62) * 3, 0, 1);
    capaFinal.style.opacity = String(fin);
    capaFinal.style.visibility = fin > 0.02 ? 'visible' : 'hidden';
    pista.style.opacity = String(clamp(1 - pr * 6, 0, 1));
  };
  addEventListener('scroll', capas, { passive: true });
  capas();

  import('three').then((THREE) => {
    const narrow = innerWidth < 760;
    let renderer: InstanceType<typeof THREE.WebGLRenderer>;
    try { renderer = new THREE.WebGLRenderer({ canvas, antialias: true }); }
    catch { canvas.style.display = 'none'; return; }
    renderer.setPixelRatio(Math.min(devicePixelRatio || 1, narrow ? 1.5 : 2));
    renderer.setClearColor(0x1b1622, 1);

    const scene = new THREE.Scene();
    scene.fog = new THREE.Fog(0x1b1622, 14, 34);
    const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 100);
    scene.add(new THREE.AmbientLight(0xffffff, 2.8));
    const sol = new THREE.DirectionalLight(0xffffff, 1.7);
    sol.position.set(-4, 14, 6);
    scene.add(sol);

    const COLS = narrow ? 15 : 27, ROWS = narrow ? 13 : 17, GAP = 0.9, N = COLS * ROWS;
    const geo = new THREE.SphereGeometry(0.2, narrow ? 12 : 18, narrow ? 10 : 14);
    const mat = new THREE.MeshStandardMaterial({ roughness: 0.6, metalness: 0 });
    const mesh = new THREE.InstancedMesh(geo, mat, N);
    scene.add(mesh);

    const logo = [['U','B','B','B','U'], ['B','U','B','U','B'], ['B','B','O','B','B']];
    const cBase = new THREE.Color(0x3a3640), cApagado = new THREE.Color(0x26232b), cHover = new THREE.Color(0x6e6976);
    const cU = new THREE.Color(0xb48af0), cB = new THREE.Color(0x3a3541), cO = new THREE.Color(0xff8a3d);
    const items: { x: number; z: number; tipo: string | null; y: number }[] = [];
    const c0 = Math.floor(COLS / 2), r0 = Math.floor(ROWS / 2);
    for (let r = 0; r < ROWS; r++) for (let c = 0; c < COLS; c++) {
      const lc = c - c0 + 2, lr = r - r0 + 1;
      const tipo = lc >= 0 && lc < 5 && lr >= 0 && lr < 3 ? logo[lr][lc] : null;
      items.push({ x: (c - (COLS - 1) / 2) * GAP, z: (r - (ROWS - 1) / 2) * GAP, tipo, y: 0 });
    }

    const m4 = new THREE.Matrix4(), q = new THREE.Quaternion(), pos = new THREE.Vector3(), esc = new THREE.Vector3(), col = new THREE.Color();
    const ray = new THREE.Raycaster(), plano = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0), hit = new THREE.Vector3();
    const mouse = new THREE.Vector2(0, 0), mouseMundo = new THREE.Vector3(99, 0, 99), mouseSuave = new THREE.Vector3(99, 0, 99);
    let hayMouse = false;

    const resize = () => {
      const w = canvas.clientWidth, h = canvas.clientHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    };
    addEventListener('resize', resize);
    resize();
    addEventListener('pointermove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
      hayMouse = true;
    });

    let t = 0, ultimo = performance.now();
    const camIni = new THREE.Vector3(0, 8.5, 13), camFin = new THREE.Vector3(0, 12.5, 0.001), mirar = new THREE.Vector3();

    const frame = (ahora: number) => {
      const dt = Math.min((ahora - ultimo) / 1000, 0.05);
      ultimo = ahora;
      if (!reduce) t += dt;
      const p = ease(progreso()), ancho = innerWidth >= 900;

      // La cámara siempre mira al centro; para dejar lugar al texto se corre la imagen, no la cámara.
      camera.position.lerpVectors(camIni, camFin, p);
      if (!reduce) { camera.position.x += mouse.x * 0.6 * (1 - p); camera.position.y += mouse.y * 0.4 * (1 - p); }
      camera.lookAt(mirar);
      camera.fov = 40 - p * 8;
      const W = canvas.clientWidth, H = canvas.clientHeight;
      if (ancho) camera.setViewOffset(W, H, -W * 0.24, 0, W, H);
      else camera.setViewOffset(W, H, 0, H * 0.16, W, H);
      camera.updateProjectionMatrix();

      if (hayMouse) { ray.setFromCamera(mouse, camera); if (ray.ray.intersectPlane(plano, hit)) mouseMundo.copy(hit); }
      mouseSuave.lerp(mouseMundo, 0.12);

      const fuerzaOla = 1 - p, fuerzaMouse = reduce ? 0 : 1 - p;
      for (let i = 0; i < N; i++) {
        const it = items[i];
        const d = Math.sqrt(it.x * it.x + it.z * it.z);
        let y = Math.sin(d * 0.55 - t * 1.3) * 0.18 * fuerzaOla;
        const dx = it.x - mouseSuave.x, dz = it.z - mouseSuave.z;
        y += Math.exp(-(dx * dx + dz * dz) / 3.2) * 0.9 * fuerzaMouse;
        let s = 1;
        if (it.tipo) {
          y += p * 0.7; s = 1 + p * 0.85;
          col.copy(cBase).lerp(it.tipo === 'U' ? cU : it.tipo === 'O' ? cO : cB, p);
        } else {
          s = 1 - p * 0.45;
          col.copy(cBase).lerp(cApagado, p);
          if (fuerzaMouse > 0) col.lerp(cHover, Math.exp(-(dx * dx + dz * dz) / 2.2) * 0.7 * fuerzaMouse);
        }
        it.y += (y - it.y) * 0.18;
        pos.set(it.x, it.y, it.z);
        esc.set(s, s, s);
        m4.compose(pos, q, esc);
        mesh.setMatrixAt(i, m4);
        mesh.setColorAt(i, col);
      }
      mesh.instanceMatrix.needsUpdate = true;
      if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;
      renderer.render(scene, camera);
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }).catch(() => { canvas.style.display = 'none'; });
</script>
