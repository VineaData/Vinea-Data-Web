---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Cinta from '../components/Cinta.astro';
import Servicios from '../components/Servicios.astro';
import Proceso from '../components/Proceso.astro';
import Casos from '../components/Casos.astro';
import Equipo from '../components/Equipo.astro';
import Contacto from '../components/Contacto.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';
import { contacto } from '../data/site';
---
<Base>
  <Header />
  <main>
    <Hero />
    <Cinta />
    <Servicios />
    <Proceso />
    <Casos />
    <Equipo />
    <Contacto />
  </main>
  <footer class="pie">
    <div>
      <span class="wm"><b>vinea</b><s></s><em>data</em></span>
      <span>{contacto.ciudad} · © {new Date().getFullYear()}</span>
    </div>
  </footer>
  <WhatsAppFlotante />
</Base>

<style>
  .pie{position:relative;z-index:4;background:var(--tinta);border-top:1px solid var(--linea);padding-block:32px calc(32px + env(safe-area-inset-bottom,0px));padding-left:var(--gutter-l);padding-right:var(--gutter-r)}
  .pie > div{max-width:1120px;margin:0 auto;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px;font:500 13px var(--mono);color:var(--texto-2)}
  .pie .wm{font:18px var(--display);color:var(--texto)}
</style>
